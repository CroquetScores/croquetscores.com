{
  "default": {
    "import": [
      "specs/**/*.steps.ts",
      "specs/support/**/*.ts",
      "specs/infrastructure/support/**/*.ts",
      "specs/web/support/**/*.ts"
    ],
    "paths": ["specs/**/*.feature"],
    "format": ["progress-bar", "html:reports/cucumber.html"],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  },
  "changed": {
    "import": [
      "specs/**/*.steps.ts",
      "specs/support/**/*.ts",
      "specs/infrastructure/support/**/*.ts",
      "specs/web/support/**/*.ts"
    ],
    "format": ["progress-bar", "html:reports/cucumber-changed.html"],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  }
}
