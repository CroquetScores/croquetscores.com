{
  "name": "next-croquetscores",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:admin",
    "build:admin": "vite build",
    "build:admin:alongside": "vite build --emptyOutDir=false",
    "dev": "tsx watch src/web/server.ts",
    "dev:admin": "vite",
    "dev:setup": "node scripts/dev-setup.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/admin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:features",
    "test:features": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:changed": "node scripts/test-changed.mjs",
    "db:up": "docker compose up -d --wait && npm run dev:setup",
    "db:down": "docker compose down -v",
    "db:migrate": "tsx src/infrastructure/database/migrate-cli.ts",
    "db:drop-tables": "tsx src/infrastructure/database/drop-tables-cli.ts",
    "test:nodb": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile nodb",
    "test:db": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile db",
    "test:browser": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile browser",
    "test:nobrowser": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile nobrowser",
    "import:ravendb": "tsx src/import-ravendb/import-ravendb.ts",
    "pretest:features": "npm run build:admin:alongside",
    "pretest:nodb": "npm run build:admin:alongside",
    "pretest:db": "npm run build:admin:alongside",
    "pretest:browser": "npm run build:admin:alongside",
    "pretest:nobrowser": "npm run build:admin:alongside",
    "pretest:changed": "npm run build:admin:alongside"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroquetScores/next.croquetscores.com.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/CroquetScores/next.croquetscores.com/issues"
  },
  "homepage": "https://github.com/CroquetScores/next.croquetscores.com#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.4",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "ravendb": "4.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.2"
  }
}
