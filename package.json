{
  "name": "next-croquetscores",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:admin && npm run build:help && npm run build:version",
    "build:help": "tsx scripts/build-help.mjs",
    "build:version": "tsx scripts/build-version.mjs",
    "help:screenshots": "tsx scripts/help-screenshots.mjs",
    "build:admin": "vite build",
    "build:admin:alongside": "vite build --emptyOutDir=false",
    "dev": "tsx watch src/web/server.ts",
    "dev:admin": "vite",
    "dev:setup": "node scripts/dev-setup.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/admin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:features",
    "test:features": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config scripts/cucumber.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "deploy": "tsx scripts/deploy.mjs",
    "db:up": "docker compose up -d --wait && npm run dev:setup",
    "db:down": "docker compose down -v",
    "db:migrate": "tsx src/infrastructure/database/migrate-cli.ts",
    "db:drop-tables": "tsx src/infrastructure/database/drop-tables-cli.ts",
    "db:rebuild-read-models": "tsx scripts/rebuild-read-models.mjs",
    "db:backup": "tsx scripts/backup.mjs",
    "db:restore": "tsx scripts/restore.mjs",
    "db:dump-import": "tsx scripts/dump-import.mjs",
    "db:create-container": "tsx scripts/create-postgres-container.mjs",
    "db:change-site-key": "tsx scripts/change-site-key.mjs",
    "db:rewrite-forgotten-accounts": "tsx scripts/rewrite-forgotten-accounts.mjs",
    "db:access": "tsx scripts/database-access.mjs",
    "test:nodb": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config scripts/cucumber.mjs --profile nodb",
    "test:db": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config scripts/cucumber.mjs --profile db",
    "test:browser": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config scripts/cucumber.mjs --profile browser",
    "test:nobrowser": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config scripts/cucumber.mjs --profile nobrowser",
    "import:ravendb": "tsx src/import-ravendb/import-ravendb.ts",
    "predev": "npm run build:admin:alongside && npm run build:help",
    "pretest:features": "npm run build:admin:alongside && npm run build:help",
    "pretest:nodb": "npm run build:admin:alongside && npm run build:help",
    "pretest:db": "npm run build:admin:alongside && npm run build:help",
    "pretest:browser": "npm run build:admin:alongside && npm run build:help",
    "pretest:nobrowser": "npm run build:admin:alongside && npm run build:help",
    "pretest:changed": "npm run build:admin:alongside && npm run build:help"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroquetScores/next.croquetscores.com.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/CroquetScores/next.croquetscores.com/issues"
  },
  "homepage": "https://github.com/CroquetScores/next.croquetscores.com#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "markdown-it": "^15.0.3",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "mailparser": "^3.9.39",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "ravendb": "4.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smtp-server": "^3.19.22",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true
  }
}
