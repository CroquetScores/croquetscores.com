DATABASE_URL=postgres://croquet_scores:croquet_scores@localhost:5432/croquet_scores
SESSION_COOKIE_SECRET=
TOKEN_SIGNING_KEY=
CANONICAL_HOST=
# What forwards requests to the site, if anything: the proxies whose word for
# where a request came from is believed, as addresses or ranges separated by
# commas. Blank in development, where nothing sits in front of the site.
TRUSTED_PROXY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OLD_SITE_PASSWORD_SALT=
ACCOUNT_ENCRYPTION_KEY=
ACCOUNT_EMAIL_ADDRESS_HASH_KEY=
# The address the site's emails are sent from. Anything deployed sets its own;
# this one goes nowhere, which is what development wants, since an email is
# written to a file rather than sent.
EMAIL_FROM_ADDRESS=croquetscores@example.com
# The name those emails are sent from, and the name each is signed off with.
EMAIL_FROM_NAME=Tim Murphy
# What an email calls the site it comes from, in its subject and its words.
EMAIL_FROM_SITE=Croquet Scores
