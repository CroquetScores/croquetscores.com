DATABASE_URL=postgres://postgres:postgres@localhost:5432/croquetscores-dev
SESSION_COOKIE_SECRET=
TOKEN_SIGNING_KEY=
# What forwards requests to the site, if anything: the proxies whose word for
# where a request came from is believed, as addresses or ranges separated by
# commas. Blank in development, where nothing sits in front of the site.
TRUSTED_PROXY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OLD_SITE_PASSWORD_SALT=
# The import from the old sites (npm run import:ravendb), which empties
# DATABASE_URL, dropping every table in it, and fills it again. Where the old
# sites' RavenDB is, and which of its databases are read, separated by commas.
# Blank is http://127.0.0.1:8080/ and both old sites.
RAVENDB_URL=
RAVENDB_DATABASES=
# Changed only by npm run db:change-site-key, which re-encrypts what it kept.
ACCOUNT_ENCRYPTION_KEY=
# Never changed: the hash it makes is kept in every registering event, so a new
# one would find no account by its address.
ACCOUNT_EMAIL_ADDRESS_HASH_KEY=
# The administrator: who the site's emails are sent from, by the name each is
# signed off with, and who is told when the site cannot reach its database or a
# backup has run. Anything deployed sets its own. This one goes nowhere, which is
# what development wants, since an email is written to a file rather than sent.
ADMINISTRATOR_EMAIL_ADDRESS=croquetscores@example.com
ADMINISTRATOR_EMAIL_FROM_NAME=Tim Murphy
# How many minutes the site waits between emailing the administrator that it
# cannot reach its database. Whole minutes, one or more; blank is 30.
DATABASE_UNREACHABLE_EMAIL_INTERVAL_MINUTES=30
# The mail server the site's emails are handed to: Brevo's, smtp-relay.brevo.com
# on port 587, with the user name and key it gives for SMTP. All four or none;
# none writes each email to a file in temp/ instead, which is what development
# wants. The connection is always encrypted, and a server that will not is not
# sent to.
SMTP_HOST=
SMTP_PORT=
SMTP_USER_NAME=
SMTP_PASSWORD=
# Whether search engines are asked to index the site: true or false, and blank
# is false. Only a site that is meant to be found says true; a site being tried
# by a few people first is not, and its robots file and every answer say so.
SEARCH_ENGINES_WELCOME=
# What npm run db:backup copies from and to, on the administrator's own
# computer: the website's database, which is only read, and the folder a file
# of its events and accounts' keys is written to each time, which must be there.
# Blank on the website.
WEBSITE_DATABASE_URL=
DATABASE_BACKUP_FOLDER=
# pg_dump, where the computer does not find it by that name, as the one that
# comes with pgAdmin is not on the path. Blank is pg_dump. It names the file and
# not the folder it is in, as C:\Program Files\PostgreSQL\17\bin\pg_dump.exe,
# written with single backslashes and no quotes.
PG_DUMP_PATH=
