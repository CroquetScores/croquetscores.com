DATABASE_URL=postgres://croquet_scores:croquet_scores@localhost:5432/croquet_scores
SESSION_COOKIE_SECRET=
TOKEN_SIGNING_KEY=
CANONICAL_HOST=
# What forwards requests to the site, if anything: the proxies whose word for
# where a request came from is believed, as addresses or ranges separated by
# commas. Blank in development, where nothing sits in front of the site.
TRUSTED_PROXY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OLD_SITE_PASSWORD_SALT=
# The import from the old sites (npm run import:ravendb), which empties
# DATABASE_URL, dropping every table in it, and fills it again. Where the old
# sites' RavenDB is, and which of its databases are read, separated by commas.
# Blank is http://127.0.0.1:8080/ and both old sites.
RAVENDB_URL=
RAVENDB_DATABASES=
# Changed only by npm run db:change-site-key, which re-encrypts what it kept.
ACCOUNT_ENCRYPTION_KEY=
# Never changed: the hash it makes is kept in every registering event, so a new
# one would find no account by its address.
ACCOUNT_EMAIL_ADDRESS_HASH_KEY=
# The address the site's emails are sent from. Anything deployed sets its own;
# this one goes nowhere, which is what development wants, since an email is
# written to a file rather than sent.
EMAIL_FROM_ADDRESS=croquetscores@example.com
# The name those emails are sent from, and the name each is signed off with.
EMAIL_FROM_NAME=Tim Murphy
# What the site is called, in its own bars and in the emails it sends.
SITE_NAME=Croquet Scores
# Which website this is: croquetscores.com, try.croquetscores.com,
# gateballscores.com, try.gateballscores.com, or localhost:3000 for development,
# which is Croquet Scores and not a try website.
WEBSITE=localhost:3000
